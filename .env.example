# Copy to .env.local for local development and mirror into Vercel -> Settings -> Environment Variables.
# Never commit .env.local or real keys to version control.

# Required: Supabase project (Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server only. Never expose to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Required in production: signs student session cookies and start tickets (32+ random characters).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Recommended in production: salt for hashing IP addresses (defaults to SESSION_SECRET if unset).
IP_HASH_SALT=

# Index or reference number format (SRS 8.3). Default: 7 to 10 digits.
INDEX_NUMBER_PATTERN=^\d{7,10}$

# Optional
NEXT_PUBLIC_APP_NAME=Aktivity
# Public origin used in week links & QR codes, e.g. https://your-app.vercel.app (defaults to request host)
NEXT_PUBLIC_SITE_URL=
# Login rate limits per 10 minutes (SRS 6.1)
RATE_LIMIT_PER_INDEX=10
RATE_LIMIT_PER_IP=1500
